{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/events", "destination": "/en/events", "permanent": true },
    { "source": "/content", "destination": "/en/gallery", "permanent": true },
    { "source": "/team", "destination": "/en/residents", "permanent": true },
    { "source": "/services", "destination": "/en/services", "permanent": true },
    { "source": "/contact", "destination": "/en/contact", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!.*\\.).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
